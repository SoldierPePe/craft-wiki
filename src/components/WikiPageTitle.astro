---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { allApps } from '../data/apps.mjs';
import { appVisuals } from '../data/appVisuals.mjs';
const slug = Astro.url.pathname.match(/^\/apps\/([^/]+)(?:\/|$)/)?.[1];
const app = slug && appVisuals[slug];
// Search results show only a page's title, and every app has a "Troubleshooting" page, so the
// result title names the app too: "CADCraft › Troubleshooting".
const appName = allApps.find(([s]) => s === slug)?.[1];
const { title } = Astro.locals.starlightRoute.entry.data;
const searchTitle = appName && appName !== title ? `${appName} › ${title}` : undefined;
---
{Astro.url.pathname !== '/' && (app
  ? <div class="wiki-page-heading"><img src={`/assets/apps/${slug}.${app.icon ?? 'webp'}`} width="64" height="64" alt="" decoding="async" /><Default /></div>
  : <Default />)}
{searchTitle && <span hidden data-pagefind-meta={`title:${searchTitle}`}></span>}

<style>
  .wiki-page-heading { display:flex; align-items:center; gap:18px; min-width:0; }
  .wiki-page-heading img { width:64px; height:64px; flex:none; object-fit:contain; }
  .wiki-page-heading :global(h1) { margin:0; min-width:0; font-family:'Archivo Variable',sans-serif; overflow-wrap:anywhere; }
  @media (max-width:40rem) {
    .wiki-page-heading { gap:12px; }
    .wiki-page-heading img { width:46px; height:46px; }
  }
</style>
